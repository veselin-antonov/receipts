# Database connection properties
MONGODB_DATABASE=
MONGODB_HOST=
MONGODB_PORT=

# Database credentials
MONGODB_AUTH_DB=
MONGODB_USER=
MONGODB_PASS=

MONGODB_DATAPATH=

# SMTP server connection properties
SMTP_HOST=
SMTP_PORT=

# SMTP Server credentials
SMTP_USER=
SMTP_PASS=

# Application port
SERVER_PORT=

# JWT Signing Keys
# For local dev, use file: prefix with path, e.g.:
#   JWT_PRIVATE_KEY=file:./src/main/resources/certs/private.pem
#   JWT_PUBLIC_KEY=file:./src/main/resources/certs/public.pem
# For production, set the full PEM content (with newlines preserved)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Application host URL
APP_HOST_URL=

# OpenAI API Key (for receipt scanning feature)
OPENAI_API_KEY=