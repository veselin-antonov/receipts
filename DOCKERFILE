# Stage 1: Build the Vite app
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source files and build
COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Install envsubst for environment variable substitution
RUN apk add --no-cache gettext

# Copy the built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template
COPY nginx/nginx.conf.template /etc/nginx/templates/default.conf.template

# Set default backend host (can be overridden at runtime)
ENV BACKEND_HOST=localhost:7002

# Upload ceiling, in MB. Single source shared with the API: its
# spring.servlet.multipart.max-file-size reads the same variable, and
# ReceiptScanService binds its check from that property. Raising the limit
# means changing this one value for both containers.
ENV MAX_UPLOAD_MB=25

# Expose port 80
EXPOSE 80

# Use envsubst to substitute environment variables and start nginx
# envsubst takes a whitelist: any variable missing from it is left literal in
# the output, and nginx then fails to parse its own config. Every ${VAR} used
# in nginx.conf.template must appear here.
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_HOST} ${MAX_UPLOAD_MB}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -t && nginx -g 'daemon off;'"]