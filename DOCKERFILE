# Stage 1: Build the Vite app
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy source files and build
COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Install envsubst for environment variable substitution
RUN apk add --no-cache gettext

# Copy the built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template
COPY nginx/nginx.conf.template /etc/nginx/templates/default.conf.template

# Set default backend host (can be overridden at runtime)
ENV BACKEND_HOST=localhost:7002

# Expose port 80
EXPOSE 80

# Use envsubst to substitute environment variables and start nginx
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_HOST}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]