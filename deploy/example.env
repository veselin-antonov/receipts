# Copy to deploy/.env and fill in. .env is gitignored; never commit it.
# Every service reads this one file (env_file in compose.yaml).

# --- ports on the host ------------------------------------------------------
UI_PORT=
SERVER_PORT=

# --- ui (nginx) ---------------------------------------------------------------
# host:port nginx proxies /api to, e.g. receipts-api:7002
BACKEND_HOST=
# upload limit in MB; keep equal to the api's (optional, default 25)
# MAX_UPLOAD_MB=25

# --- api: public URL, used in verification e-mails ---------------------------
APP_HOST_URL=

# --- api: database -------------------------------------------------------------
MONGODB_HOST=receipts-db
MONGODB_PORT=
MONGODB_DATABASE=
MONGODB_AUTH_DB=
MONGODB_USER=
MONGODB_PASS=
# host directory mounted as mongo's /data/db
MONGODB_DATAPATH=

# --- api: mail ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- api: JWT signing keys (PEM content, quoted, newlines kept) --------------------
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- api: receipt scanning ---------------------------------------------------------
# required for scanning; everything else works without it
OPENAI_API_KEY=
# optional, defaults in api/src/main/resources/application.yaml
# OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=
# OCR_LANGUAGE=eng+bul
# TESSDATA_PATH=
# OCR_DEBUG_OUTPUT_PATH=

# --- api: misc -------------------------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# LOGGING_LEVEL_ROOT=INFO
