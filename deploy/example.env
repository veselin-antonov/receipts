# Copy to deploy/.env and fill in. .env is gitignored; never commit it.
# The api reads all of it (env_file); compose interpolates the ui's port and
# the database's credentials and data path from it. The stack's own addresses
# (SERVER_PORT, MONGODB_HOST, MONGODB_PORT, the ui's BACKEND_HOST) are set in
# compose.yaml.

# --- the one host port: the ui (optional, default 7820) -----------------------
# UI_PORT=7820
# upload limit in MB, for the api and the ui's nginx (optional, default 25)
# MAX_UPLOAD_MB=25
# log time zone; stored dates are UTC (optional, default Europe/Sofia)
# TZ=Europe/Sofia

# --- api: public URL: verification e-mail links, and the CORS origin ------------
APP_HOST_URL=https://receipts.vasoft.dev
# defaults to APP_HOST_URL; list more origins comma-separated
# APP_CORS_ALLOWED_ORIGINS=

# --- database --------------------------------------------------------------------
MONGODB_DATABASE=receipts
# MongoDB creates three logins on an empty data directory (compose.yaml,
# create-users.js); all authenticate against admin.
MONGODB_AUTH_DB=admin
# root: administration only, nothing logs in with it routinely
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASS=
# the api's login: readWrite on MONGODB_DATABASE only
MONGODB_USER=receipts-api
MONGODB_PASS=
# receipts-reader: read only, what make db-refresh and make preview copy with
MONGODB_READER_PASS=
# host directory mounted as mongo's /data/db
MONGODB_DATAPATH=./data

# --- api: mail ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- api: JWT signing keys (PEM content, quoted, newlines kept) --------------------
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- api: receipt scanning ---------------------------------------------------------
# required for scanning; everything else works without it
OPENAI_API_KEY=
# optional, defaults in api/src/main/resources/application.yaml
# OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=
# chat-completions (default) or responses; see ADR-0008
# OPENAI_CHAT_API=
# OCR_LANGUAGE=eng+bul
# TESSDATA_PATH=
# OCR_DEBUG_OUTPUT_PATH=

# --- api: misc -------------------------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# LOGGING_LEVEL_ROOT=INFO
