# Database connection properties
MONGODB_DATABASE=
MONGODB_HOST=
MONGODB_PORT=

# Database credentials
MONGODB_AUTH_DB=
MONGODB_USER=
MONGODB_PASS=

MONGODB_DATAPATH=

# SMTP server connection properties
SMTP_HOST=
SMTP_PORT=

# SMTP Server credentials
SMTP_USER=
SMTP_PASS=

# Application port
SERVER_PORT=

# JWT Signing Keys
# The dev profile defaults to file:./certs/private.pem and file:./certs/public.pem
# (api/certs, gitignored, written by scripts/dev-setup.sh); leave these empty.
# Never put keys under src/main/resources: the build refuses a jar with a .pem.
# For production, set the full PEM content (with newlines preserved)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Application host URL
APP_HOST_URL=

# CORS: comma-separated origins the browser may call the api from. Must include
# every origin a browser uses, including a reverse proxy's in front of the ui
# (dev profile default: http(s)://localhost:5173,http://localhost:7863)
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://receipts.example.com

# Upload limit in MB, shared by the api and the ui's nginx (default 25)
# MAX_UPLOAD_MB=25

# Container time zone; storage is always UTC (default UTC)
# TZ=UTC

# OCR (Tesseract). The dev profile's tessdata default is a Windows path;
# scripts/dev-setup.sh writes the Linux one it finds
# TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata
# OCR_LANGUAGE=eng+bul
# Where OCR debug images go (dev profile default ./ocr-debug, none otherwise)
# OCR_DEBUG_OUTPUT_PATH=./ocr-debug

# OpenAI API Key (for receipt scanning feature)
OPENAI_API_KEY=
# Optional, defaults in api/src/main/resources/application.yaml
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=medium
# chat-completions (default) or responses; see ADR-0008
# OPENAI_CHAT_API=chat-completions

# Rate limiting; only the scan benchmark turns it off, never a deployment
# RATE_LIMIT_ENABLED=true

# --- dev stack (api/docker-compose.dev.yml) and preview testing -------------
# docs/DEV_SETUP.md, "Testing a pull request". Normally set on the command line.
# Host port of the ui container (default 7863)
# UI_PORT=7863
# ui image tag: dev (master) or a pull request's pr-<n>
# UI_TAG=dev
# api image tag for the optional receipts-api service (profile `api`)
# API_TAG=dev
# Host port of the receipts-api container, next to the native api (default 7003)
# API_CONTAINER_PORT=7003
# Where the ui's nginx proxies /api/ (default host.docker.internal:SERVER_PORT);
# host.docker.internal:7003 is the receipts-api container. The dev stack does
# not read BACKEND_HOST from this file; that one is for deploy/example.env
# UI_BACKEND=host.docker.internal:7002
